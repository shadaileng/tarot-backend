PORT=3000
NODE_ENV=development
TZ=Asia/Shanghai
LOG_LEVEL=info

GEMINI_API_KEY=your_gemini_api_key

CORS_ORIGIN=*

DB_PATH=./data/tarot.db
LOG_RETENTION_DAYS=30

# 备份配置
# BACKUP_DIR=./data/backups
# UPLOADS_DIR=./data/uploads

CACHE_MAX_SIZE=100
CACHE_TTL_SECONDS=3600

POOL_MAX_PAGES=4
POOL_ACQUIRE_TIMEOUT_MS=30000

# Puppeteer 配置（Docker 部署时设置）
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage

# 微信小程序登录配置
WECHAT_APPID=
WECHAT_SECRET=

# JWT 签名密钥（用于用户登录 token，生产环境必须设置）
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 管理员认证 Token 过期时间（支持 ms 格式：30m/2h/7d/30d）
ADMIN_ACCESS_EXPIRES_IN=2h
ADMIN_REFRESH_EXPIRES_IN=30d

# 管理员初始账号（默认 admin / admin@123456，首次登录须修改密码）
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=admin@123456
