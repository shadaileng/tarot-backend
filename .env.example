PORT=3000
NODE_ENV=development

GEMINI_API_KEY=your_gemini_api_key

CORS_ORIGIN=*

DB_PATH=./data/tarot.db
LOG_RETENTION_DAYS=30

CACHE_MAX_SIZE=100
CACHE_TTL_SECONDS=3600

POOL_MAX_PAGES=4
POOL_ACQUIRE_TIMEOUT_MS=30000

WECHAT_APPID=
WECHAT_SECRET=
JWT_SECRET=

# 管理员初始账号（默认 admin / admin@123456，首次登录须修改密码）
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=admin@123456
