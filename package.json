{
  "name": "tarot-backend",
  "version": "2.18.1",
  "description": "塔罗牌后台服务 - AI 解读 + 海报生成",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/poster/templates/*.html src/poster/templates/*.css dist/poster/templates/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^23.6.0",
    "sql.js": "^1.14.1",
    "undici": "^7.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^11.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.2",
    "vitest": "^4.1.9"
  }
}
